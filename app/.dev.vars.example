# Local secrets for `wrangler pages dev`. Copy this file to `.dev.vars` (which is
# gitignored) and fill in real values. NEVER commit real tokens.

# Dry-run: log the exact payload and post NOTHING to GHL. Leave =1 for safe local
# testing; unset or blank it to make real CRM calls.
GHL_DRY_RUN=1

# One GHL Private Integration Token per client, named GHL_PIT_<SLUG> where SLUG is the
# client's slug uppercased with non-alphanumerics turned into underscores:
#   texas-tree-tops  -> GHL_PIT_TEXAS_TREE_TOPS
#   j-valdez         -> GHL_PIT_J_VALDEZ
# Create the token in that client's own GHL sub-account (Settings -> Private
# Integrations). Paste it after the "=", with no quotes.
GHL_PIT_TEXAS_TREE_TOPS=<paste-this-clients-ghl-private-integration-token>
GHL_PIT_J_VALDEZ=<paste-this-clients-ghl-private-integration-token>
