# Content editor (server/) — Railway service. Names only; values live in Railway or a
# local .env that is gitignored (R3). Generate the password hash with:
#   cd server && npm run hash-password -- 'your password'

DASHBOARD_PASSWORD_HASH=   # scrypt$<salt>$<key> — the ONE admin password; nothing renders without it
SESSION_SECRET=            # long random string; signs the session cookie (openssl rand -hex 32)
GITHUB_TOKEN=              # fine-grained PAT with contents:write on the repo below; used for clone/pull/push only
GITHUB_REPO=Sosa24369/-tree-template-factory-   # owner/name the service clones and pushes to
REPO_DIR=/data/repo        # working clone on the Railway volume (mount the volume at /data)
CLOUDFLARE_API_TOKEN=      # Pages:Edit token; publish fails loudly at 'deploying' without it
CLOUDFLARE_ACCOUNT_ID=     # the account that owns the Pages project
CF_PAGES_PROJECT=tree-template-factory   # wrangler pages deploy --project-name
PORT=8787                  # Railway sets this; keep for local runs
# DASHBOARD_INSECURE_COOKIE=1   # LOCAL http only — drops the cookie's Secure flag. Never set on Railway.
