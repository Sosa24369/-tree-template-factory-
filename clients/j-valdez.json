  "reviews": [
    {
      "author": "Josh M.",
      "meta": "8 hours ago",
      "rating": 5,
      "body": "Have many neighbors who have used J Valdez Tree Services and heard great things. Set up a time to meet with Felix and did a prior walk through with me and then scheduled the job. His crew showed up when they said they would and did everything exactly as described. They are quick, clean and efficient. Would highly recommend to anyone needing tree work done. Great work and great pricing."
    },
    {
